{
  "name": "simstay-app",
  "version": "0.1.0",
  "private": true,
  "description": "SimStay: the AI-native frontline operating system for hospitality (GITA SmartStay 3.0 prototype)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/simustay/grader.test.ts src/lib/simustay/windows.test.ts",
    "demo": "node scripts/demo.mjs",
    "demo:build": "node scripts/demo.mjs --build-only --force",
    "demo:fixtures": "node scripts/gen-fixtures.mjs",
    "demo:check": "node scripts/demo-preflight.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/noto-sans-georgian": "^5.2.5",
    "lucide-react": "^0.468.0",
    "next": "^15.5.26",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
